{
  "manifest_version": 3,
  "name": "herdr Browser Tab Groups",
  "version": "0.6.3",
  "description": "Shows the Chrome tab group of the focused herdr workspace. Companion to HerdrBrowserTabGroups.app.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "herdr Browser Tab Groups — click to re-sync"
  },
  "key": ""
}
